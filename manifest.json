{
  "manifest_version": 3,
  "name": "AI Prompt Vault",
  "version": "2.0.0",
  "description": "Save, organize, search, and copy your AI prompts — with tags, themes, archive, trash, and more.",
  "action": {
    "default_popup": "index.html",
    "default_title": "AI Prompt Vault"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
