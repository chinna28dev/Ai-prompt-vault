{
  "manifest_version": 3,
  "name": "AI Prompt Vault",
  "version": "1.0.0",
  "description": "Save, organize, search and copy your favorite AI prompts.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Prompt Vault"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}